# ─── Application ──────────────────────────────────────────────────────────────
# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Storage (relative to backend working directory)
RUNTIME_DIR=../runtime
UPLOAD_DIR=../runtime/uploads
RESULTS_DIR=../runtime/results
DATABASE_URL=sqlite:///./runtime/app.db

# ─── ML ────────────────────────────────────────────────────────────────────────
# Path to the trained checkpoint (relative to backend working directory)
MODEL_CHECKPOINT=../runtime/checkpoints/best_model.pt

# Patch size used during training and inference
PATCH_SIZE=256

# MC-Dropout inference passes
MC_PASSES=10

# Trust-gate percentiles (validation-set derived)
TRUST_LOW_PERCENTILE=10
TRUST_HIGH_PERCENTILE=90

# ─── Frontend ─────────────────────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8000
